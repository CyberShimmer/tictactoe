<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:background="@color/bg_normal">


<TextView android:id="@+id/txt_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_marginTop="64dp" android:layout_gravity="center_horizontal"
    android:text="O" android:textColor="@color/player_O" android:textSize="120dp" android:fontFamily="monospace"/>

<TextView android:id="@+id/txt_score" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_marginBottom="16dp" android:layout_gravity="center_horizontal"
    android:text="0 - 0" android:textColor="@color/score_normal" android:textSize="80dp" android:fontFamily="monospace" />

<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_gravity="center">

<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
    <Button android:id="@+id/btn1" style="@style/btn_grid" android:text="" />
    <View android:layout_width="4dp" android:layout_height="match_parent" android:background="@color/cell_border" />
    <Button android:id="@+id/btn2" style="@style/btn_grid" android:text="" />
    <View android:layout_width="4dp" android:layout_height="match_parent" android:background="@color/cell_border" />
    <Button android:id="@+id/btn3" style="@style/btn_grid" android:text="" />
</LinearLayout>

<View android:layout_width="match_parent" android:layout_height="4dp" android:background="@color/cell_border" />
    
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
    <Button android:id="@+id/btn4" style="@style/btn_grid" android:text="" />
    <View android:layout_width="4dp" android:layout_height="match_parent" android:background="@color/cell_border" />
    <Button android:id="@+id/btn5" style="@style/btn_grid" android:text="" />
    <View android:layout_width="4dp" android:layout_height="match_parent" android:background="@color/cell_border" />
    <Button android:id="@+id/btn6" style="@style/btn_grid" android:text="" />
</LinearLayout>

<View android:layout_width="match_parent" android:layout_height="4dp" android:background="@color/cell_border" />
    
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
    <Button android:id="@+id/btn7" style="@style/btn_grid" android:text="" />
    <View android:layout_width="4dp" android:layout_height="match_parent" android:background="@color/cell_border" />
    <Button android:id="@+id/btn8" style="@style/btn_grid" android:text="" />
    <View android:layout_width="4dp" android:layout_height="match_parent" android:background="@color/cell_border" />
    <Button android:id="@+id/btn9" style="@style/btn_grid" android:text="" />
</LinearLayout>

</LinearLayout>

<Button android:id="@+id/btn_reset" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:background="@color/cell_normal"
    android:text="Reset" android:textColor="@color/reset_normal" android:textSize="50dp" android:fontFamily="monospace"/>

</LinearLayout>
